[Unit]
Description=Update Retuner to the latest release
Documentation=https://github.com/ollisulopuisto/retuner/blob/master/doc/APPLIANCE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root, because it replaces the binary and restarts the unit. The script itself
# does nothing else with the privilege: it never touches retuner.ini or config/.
ExecStart=/opt/retuner/retuner-update.sh
Environment=PREFIX=/opt/retuner
Environment=SERVICE=retuner

# SQL resources embedded via res/sql.rc — generated from src/sql/*.sql
# (script/zip-sql.bat on Windows, script/zip-sql.sh elsewhere)
res/*.zip

# Build output. Anchored to the repository root: unanchored, "bin/" also matched
# retuner/rootfs/usr/bin, which silently kept a file the add-on image needs out
# of the commit.
/.build/
/bin/
/lib/
*.o
*.or
*.ppu
*.a
*.compiled
*.res
/backup/

# Lazarus per-user session state
*.lps

# Runtime directories created next to the binary
/cache/
/config/
/db/
heap.trc
